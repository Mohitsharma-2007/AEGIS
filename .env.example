# ============================================================================
# Aegis - environment template (NAMES ONLY)
#
# Copy this file to `.env.local` and paste YOUR OWN keys there. `.env.local` is
# gitignored and is never printed, logged or shipped. Real keys must never be
# written into this template: it is meant to be shared with the repository.
#
# Provider endpoints are hard-coded in apps/host/src/server/providers.ts; you
# only ever supply keys. Pick the active provider in Settings, or here.
# ============================================================================

# Active provider (openrouter | groq | nvidia | conduit | tokenharbor | vercel | local)
AEGIS_PROVIDER=openrouter
# Optional model override (otherwise the provider's default model is used)
AEGIS_MODEL=

# --- Provider keys: leave blank unless you have that provider's key ----------
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CONDUIT_API_KEY=
TOKENHARBOR_API_KEY=
VERCEL_AI_KEY=
INCEPTION_API_KEY=
HF_TOKEN=
# Local model server (Ollama / LM Studio). The server ignores the key, but
# Aegis needs one to treat the provider as configured: use "ollama".
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional per-provider endpoint overrides (only for local stubs/proxies)
OPENROUTER_BASE_URL=
GROQ_BASE_URL=
NVIDIA_BASE_URL=
CONDUIT_BASE_URL=
TOKENHARBOR_BASE_URL=
VERCEL_GATEWAY_URL=
# Local model server (Ollama / LM Studio / llama.cpp). Any value works.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenCode harness sidecar (opencode serve on :4096). Optional: set a stable
# password; otherwise start scripts generate one into
# .aegis-data/opencode-password (gitignored, never printed).
AEGIS_OPENCODE_PASSWORD=

# Aegis daemon (memory / MCP services layer)
AEGIS_DAEMON_URL=http://127.0.0.1:8765
AEGIS_PROVENANCE_STRICT=false

# Browser engine: Playwright only (AEGIS Computer browser). The browser
# service runs as a host process; the Obscura engine is removed.
AEGIS_BROWSE_ENGINE=playwright
# Browser service wire endpoints (auto-started by the desktop shell).
BROWSER_URL=http://127.0.0.1:4311
# BROWSER_SECRET=set-a-long-random-secret

# Aegis computer sidecar (optional; runs from the vendored openmuse tree)
AEGIS_COMPUTER_URL=

# Host logging (defaults to <root>/.aegis-data/logs)
AEGIS_LOG_DIR=

# Legacy / optional upstream integrations (all optional)
OPENAI_API_KEY=
OPENAI_MODEL=
COMPOSIO_API_KEY=
VOICE_API_KEY=
VOICE_MODEL=
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=

# Voice (local STT/TTS)
# Recommended multilingual models (Hindi/Hinglish/English):
#   STT: faster-whisper large-v3-turbo (or distil-large-v3) via an OpenAI-compatible server
#   TTS: piper with hi_IN / en_US voices, or Coqui XTTS v2
# VOICE_BASE_URL=http://127.0.0.1:8000
# STT_ENDPOINT=http://127.0.0.1:8000/v1/audio/transcriptions
# TTS_ENDPOINT=http://127.0.0.1:8000/v1/audio/speech
# VOICE_NAME=hi_IN

# Pipecat voice pipeline (services/daemon, Python 3.11 venv)
# The service loads .env.local when started directly; the desktop app passes
# its environment through. See services/daemon/README.md for model downloads.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8_float16
# WHISPER_PROFILE=auto
# WHISPER_LANGUAGE=
# VOICE_STT_TTFS=0.5
# VOICE_CLEANUP=auto
# VOICE_CLEANUP_MODEL=
# VOICE_TTS=auto
# VOICE_NOISE_SUPPRESSION=1
# Windows Voice Bridge (command-only access through the Windows speech engine)
# WINDOWS_VOICE_URL=http://127.0.0.1:8767
# WINDOWS_BRIDGE_LANGUAGE=en-US
# WINDOWS_BRIDGE_DICTATION=1
# KOKORO_MODEL=
# KOKORO_VOICES=
# KOKORO_VOICE_EN=af_heart
# KOKORO_VOICE_HI=hf_alpha
# KOKORO_SPEED=1.0
# PIPER_VOICE=hi_IN-pratham-medium
# PIPER_VOICE_EN=en_US-lessac-medium
# VOICES_DIR=services/daemon/voices
