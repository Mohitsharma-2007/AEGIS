  "states": {
    "idle": {
      "label": "Idle",
      "when": "Resting, waiting for input",
      "character": "any",
      "loopSeconds": 6,
      "oneShot": false,
      "then": null
    },
    "hello": {
      "label": "Hello / wake",
      "when": "App launch, wake word heard, greeting",
      "character": "any",
      "loopSeconds": 2.4,
      "oneShot": true,
      "then": "idle"
    },
    "listening": {
      "label": "Listening",
      "when": "Microphone open, user is speaking",
      "character": "any",
      "loopSeconds": 2.4,
      "oneShot": false,
      "then": null
    },
    "thinking": {
      "label": "Thinking",
      "when": "Model is reasoning / generating a plan",
      "character": "any",
      "loopSeconds": 3,
      "oneShot": false,
      "then": null
    },
    "searching": {
      "label": "Searching",
      "when": "Web / file / memory search, tool lookups",
      "character": "any",
      "loopSeconds": 3.2,
      "oneShot": false,
      "then": null
    },
    "working": {
      "label": "Working / loading",
      "when": "Long task running, tool executing, loading",
      "character": "any",
      "loopSeconds": 1.6,
      "oneShot": false,
      "then": null
    },
    "speaking": {
      "label": "Speaking",
      "when": "TTS audio is playing",
      "character": "any",
      "loopSeconds": 1.2,
      "oneShot": false,
      "then": null
    },
    "sending": {
      "label": "Sending",
      "when": "Prompt submitted (Enter / send button)",
      "character": "any",
      "loopSeconds": 1.6,
      "oneShot": true,
      "then": "thinking"
    },
    "paused": {
      "label": "Paused",
      "when": "User paused the agent / playback",
      "character": "any",
      "loopSeconds": 3,
      "oneShot": false,
      "then": null
    },
    "cancelled": {
      "label": "Cancelled",
      "when": "User cancelled / task aborted",
      "character": "any",
      "loopSeconds": 1.8,
      "oneShot": true,
      "then": "idle"
    },
    "done": {
      "label": "Done / success",
      "when": "Task finished successfully",
      "character": "any",
      "loopSeconds": 2.4,
      "oneShot": true,
      "then": "idle"
    },
    "notification": {
      "label": "Notification",
      "when": "New message, reminder, something needs attention",
      "character": "any",
      "loopSeconds": 2.2,
      "oneShot": false,
      "then": null
    },
    "confused": {
      "label": "Confused",
      "when": "Didn't understand, low confidence, needs clarification",
      "character": "any",
      "loopSeconds": 3,
      "oneShot": false,
      "then": null
    },
    "error": {
      "label": "Error",
      "when": "Something failed (network, tool, permission)",
      "character": "any",
      "loopSeconds": 2,
      "oneShot": false,
      "then": null
