{
  "name": "aegis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis desktop shell: supervises the local services and hosts the one Aegis UI in a native window.",
  "main": "main.js",
  "author": "Aegis",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64",
    "icons": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "dev.aegis.desktop",
    "productName": "Aegis",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "file-tray.js",
      "clipboard-history.js",
      "media-session.ps1",
      "coding-processes.ps1",
      "preload.js",
      "loading.html",
      "ui-kit/*.html",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Aegis"
    }
  }
}
